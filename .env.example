# ---------------------------------------------------------------------------
# Supabase (required for auth, orders, stock)
# Create a project at https://supabase.com then paste values here.
# NEVER expose SERVICE_ROLE_KEY to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public site URL used for auth redirects and payment callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# iyzico Checkout Form (sandbox first)
# Do NOT fill with production keys until sandbox flow is verified.
# Payment init will refuse to run until these are set.
# ---------------------------------------------------------------------------
IYZICO_API_KEY=YOUR_IYZICO_SANDBOX_API_KEY
IYZICO_SECRET_KEY=YOUR_IYZICO_SANDBOX_SECRET_KEY
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL=http://localhost:3000/api/payments/iyzico/callback

# Installment preview rates: count:percent (0 = interest-free)
NEXT_PUBLIC_INSTALLMENT_PLAN_RATES=1:0,2:0,3:0,6:4.5,9:7.5

# Optional shared secret for webhook HMAC verification (if configured)
IYZICO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Commerce defaults
# ---------------------------------------------------------------------------
STOCK_RESERVATION_MINUTES=30
FREE_SHIPPING_THRESHOLD=1500
SHIPPING_FEE=99

# ---------------------------------------------------------------------------
# Admin panel — password only gate for /admin
# Set the same value in Vercel Production env.
# ---------------------------------------------------------------------------
ADMIN_PANEL_PASSWORD=change-me-strong-password

# ---------------------------------------------------------------------------
# Real email (newsletter welcome + stock alerts)
# Free tier: https://resend.com — verify domain or use onboarding@resend.dev
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=Bee Kozmetik <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# SEO / Analytics (optional until you have accounts)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# Instagram feed (optional). Without token: local images or Unsplash fallback.
# Long-lived User token from Instagram Graph / Basic Display.
# ---------------------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Notifications stubs
# ---------------------------------------------------------------------------
SMS_PROVIDER=stub
